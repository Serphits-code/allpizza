# Conexao PostgreSQL (padrao local deste projeto utiliza porta 5433 ou 5432)
# Para restaurar os dados completos cadastrados, utilize o arquivo prisma/alldelivery_backup.sql
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/alldelivery?schema=public"
NEXTAUTH_SECRET="secret-local-32-chars-at-least-long-random-string"
NEXTAUTH_URL="http://localhost:3001"
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""          # Se vazio, usa fallback Leaflet/OSM
UPLOAD_DIR="./public/uploads"

