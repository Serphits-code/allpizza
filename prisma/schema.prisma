generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  imageUrl    String
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model PizzaCategory {
  id      String        @id @default(cuid())
  name    String        @unique
  priceP  Float
  priceM  Float
  priceG  Float
  priceGG Float
  flavors PizzaFlavor[]
}

model PizzaFlavor {
  id              String        @id @default(cuid())
  name            String
  description     String
  imageUrl        String
  pizzaCategoryId String
  category        PizzaCategory @relation(fields: [pizzaCategoryId], references: [id])

  @@index([pizzaCategoryId])
}

model DeliveryZone {
  id          String   @id @default(cuid())
  title       String
  geometry    Json
  deliveryFee Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      Int           @unique @default(autoincrement())
  status           OrderStatus   @default(NOVO)
  type             OrderType     @default(DELIVERY)
  customerName     String
  customerPhone    String
  customerAddress  String?
  addressNumber    String?
  reference        String?
  customerLat      Float?
  customerLng      Float?
  paymentMethod    PaymentMethod @default(PIX)
  changeFor        Float?
  subtotal         Float
  deliveryFee      Float         @default(0)
  total            Float
  notes            String?
  createdAt        DateTime      @default(now())
  preparedAt       DateTime?
  sentAt           DateTime?
  readyForPickupAt DateTime?
  deliveredAt      DateTime?
  driverId         String?
  driver           AdminUser?    @relation("DriverOrders", fields: [driverId], references: [id])
  comandaId        String?
  comanda          Comanda?      @relation(fields: [comandaId], references: [id])
  items            OrderItem[]

  @@index([customerPhone])
  @@index([status])
  @@index([createdAt])
  @@index([driverId])
  @@index([comandaId])
  @@index([type])
  @@index([status, createdAt])
  @@index([type, status, createdAt])
}

model OrderItem {
  id         String            @id @default(cuid())
  orderId    String
  name       String
  quantity   Int
  basePrice  Float
  totalPrice Float
  isPizza    Boolean           @default(false)
  pizzaSize  String?
  crustType  String?
  crustPrice Float             @default(0)
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  flavors    OrderItemFlavor[]
  toppings   OrderItemTopping[]

  @@index([orderId])
}

model OrderItemFlavor {
  id           String    @id @default(cuid())
  orderItemId  String
  flavorName   String
  categoryName String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model OrderItemTopping {
  id          String    @id @default(cuid())
  orderItemId String
  toppingName String
  targetType  String
  flavorName  String?
  slicesCount Int       @default(1)
  totalSlices Int       @default(1)
  price       Float
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model PizzaToppingCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  toppings  PizzaTopping[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PizzaTopping {
  id         String               @id @default(cuid())
  name       String
  pricePM    Float
  priceGGG   Float
  isUnit     Boolean              @default(false)
  categoryId String
  category   PizzaToppingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([categoryId])
}

model CustomerContactProfile {
  id                  String   @id @default(cuid())
  phoneKey            String   @unique
  notes               String?
  displayNameOverride String?
  createdAt           DateTime @default(now())
}

model AdminUser {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  role              UserRole           @default(KITCHEN)
  name              String
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  driverLat         Float?
  driverLng         Float?
  driverUpdatedAt   DateTime?
  driverActiveRoute DriverActiveRoute?
  orders            Order[]            @relation("DriverOrders")

  @@index([role, active])
}

model DriverActiveRoute {
  driverId      String    @id
  orderedIds    String[]
  steps         Json
  routeGeometry Json
  summary       Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  driver        AdminUser @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model CrustType {
  id        String   @id @default(cuid())
  name      String   @unique
  pricePM   Float
  priceGGG  Float
  caracol   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comanda {
  id              String        @id @default(cuid())
  number          Int           @unique
  status          ComandaStatus @default(LIVRE)
  responsibleName String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orders          Order[]
}

model SystemConfig {
  key   String @id
  value String
}

enum OrderStatus {
  NOVO
  EM_PREPARO
  EM_ROTA
  PRONTO_RETIRADA
  ENTREGUE
  COMANDA_MESA
  CANCELADO
}

enum OrderType {
  DELIVERY
  RETIRADA
  COMANDA
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CREDITO
  DEBITO
}

enum UserRole {
  ADMIN
  MANAGER
  KITCHEN
  DRIVER
  GARCOM
}

enum ComandaStatus {
  LIVRE
  OCUPADA
  INATIVA
}
